# =============================================================================
# Lucky — 环境变量配置
# =============================================================================
# 复制本文件为 .env / .env.local 并按需修改。
# 加载优先级（高→低）：.env.local > .env.{NODE_ENV} > .env
#
# 主进程变量（process.env）：在 src/main/index.ts 入口处从 .env 文件加载
# 渲染进程变量（import.meta.env）：仅 VITE_ 前缀变量，由 Vite 自动注入
# =============================================================================

# --- 通用 ---

# 日志级别
# 可选：debug | info | warn | error
# LUCKY_LOG_LEVEL=info

# Web Research 引擎
# electron  - 借助 Electron BrowserWindow 抓取（默认，节约系统资源）
# playwright - 借助 Playwright 抓取（兼容性更广，需安装系统浏览器）
LUCKY_WEB_RESEARCH_ENGINE=electron

# 开发模式下是否自动打开 DevTools
# LUCKY_DEV_TOOLS=true

# --- AI Provider 配置（可选，用于快速初始化） ---

# Ollama 默认地址
# LUCKY_OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI 兼容 API 默认地址
# LUCKY_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Agent 内置 Skill（可选） ---

# 是否启用内置英文 Skill：
# - Chat Agent：通用任务、研究、整理、上下文对话
# - Code Agent：参考 Claude Code 的 inspect -> edit -> verify -> review 代码工作流
LUCKY_AGENT_BUILTIN_SKILLS=true

# 追加外部 Skill 文件/目录。多个路径用系统 PATH 分隔符：
# macOS/Linux 使用冒号 (:)，Windows 使用分号 (;)
# LUCKY_AGENT_EXTRA_SKILL_PATHS=/abs/path/to/chat-skill.md:/abs/path/to/code-skill.md
# LUCKY_AGENT_EXTRA_SKILL_DIRS=/abs/path/to/skills

# --- 数据目录（可选，默认使用 Electron app.getPath('userData')） ---

# LUCKY_DATA_DIR=
# LUCKY_DB_PATH=

# --- 渲染进程变量（VITE_ 前缀，通过 import.meta.env 访问） ---

# VITE_APP_TITLE=Lucky
# VITE_DEFAULT_LOCALE=zh-CN
