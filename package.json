{
  "name": "lucky-ai-client",
  "version": "0.1.5",
  "description": "Lucky — desktop AI coding agent",
  "license": "GPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dennis9486/lucky-ai.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE -u NODE_OPTIONS electron-vite dev",
    "build": "pnpm type-check && electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE -u NODE_OPTIONS electron-vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "@agentscope-ai/agentscope": "^0.0.12",
    "@shikijs/monaco": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vueuse/core": "^13.9.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "better-sqlite3": "^12.11.1",
    "crawlee": "^3.17.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "electron-updater": "^6.8.9",
    "eslint": "^9.18.0",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.468.0",
    "marked": "^15.0.6",
    "monaco-editor": "^0.52.2",
    "monaco-languageclient": "^10.7.0",
    "node-pty": "^1.1.0",
    "pinia": "^2.3.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.1",
    "shiki": "^4.3.0",
    "vue": "^3.5.34",
    "vue-i18n": "^10.0.7",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/language-server": "^3.3.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint-plugin-vue": "^10.9.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.62.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "space.luckly.ai.client",
    "productName": "Lucky",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dennis9486",
        "repo": "lucky-ai",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "@electron/rebuild": "3.7.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "node-pty"
    ]
  }
}
